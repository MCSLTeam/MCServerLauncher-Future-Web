{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCServerLauncher Future",
  "version": "0.1.0",
  "identifier": "cn.com.mcsl.future.tauri",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web frontend:dev",
    "devUrl": "http://localhost:3000/",
    "beforeBuildCommand": "pnpm --dir ../web frontend:build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "width": 1280,
        "minHeight": 500,
        "minWidth": 400,
        "resizable": true,
        "title": "MCServerLauncher Future",
        "visible": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
