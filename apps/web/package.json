{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm frontend:build && cargo build --release",
    "build:docker": "cd ../../; docker build -f apps/web/Dockerfile --progress=plain -t mcsl-future-web .; cd -",
    "backend:dev": "cargo run",
    "frontend:dev": "next dev --port 3000",
    "frontend:build": "NEXT_EXPORT=1 next build && node ./scripts/sync-dist.mjs",
    "frontend:preview": "next start --port 3000",
    "lint": "eslint .; prettier --check .; cargo lint",
    "fix": "eslint --fix; prettier --write --list-different .; cargo fix",
    "test": "tsc --noEmit && cargo test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.5",
    "@repo/locales": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.18.0",
    "next": "^16.2.9",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "prettier": "^3.8.1",
    "shadcn": "4.11.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "zod": "3.25.76"
  }
}
